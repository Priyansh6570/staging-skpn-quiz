# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env*.local

# the answer key — must never be committed and must never reach public/
design/uploads/quiz-questions.json
design/uploads/questions.json

# Source material for the Vidya/Kala extraction, not deliverables: the scanned book, the page
# splits, and the full-resolution figures cut out of them. Only vidya-kala.json, vk-map.json and the
# optimised figures ship. These live outside public/ so the build cannot serve a copyrighted book —
# .gitignore keeps them out of git, it does not keep them out of a deployment.
/split/
/po.pdf
/figures-raw/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
